# Signer for delegations, quote signing, and EIP-7702 smart account
PRIVATE_KEY=

# Base mainnet RPC — use a full URL with your provider key embedded
BASE_RPC_URL=https://base-mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Default swap pair (Base USDC → WETH)
LIFI_FROM_TOKEN=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
LIFI_TO_TOKEN=0x4200000000000000000000000000000000000006

# Default execute input amount (token atoms, e.g. 1000000 = 1 USDC)
LIFI_FROM_AMOUNT=1000000

# Destination chain for swaps (8453 = Base same-chain)
LIFI_TO_CHAIN=8453

# Li.FI API slippage (decimal, e.g. 0.005 = 0.5%)
LIFI_SLIPPAGE=0.005

# Default periodic budget for `delegation create`
LIFI_PERIOD_AMOUNT=10000000
LIFI_PERIOD_DURATION=86400

# On-chain slippage cap in enforcer terms (basis points)
LIFI_SLIPPAGE_BPS=50

# 1Shot public relayer (optional override)
RELAYER_URL=https://relayer.1shotapi.com/relayers
